# Copy to .env in the repository root; restart after changing settings.
VOR_MODEL=yolo11m.pt
VOR_FALLBACK_MODEL=yolo11s.pt
VOR_DEVICE=auto
VOR_IMAGE_SIZE=640
VOR_DETECTION_CONFIDENCE=0.15
VOR_MAX_FILE_MB=20
VOR_MAX_IMAGE_PIXELS=40000000
VOR_MAX_UPLOAD_FILES=50
VOR_MAX_UPLOAD_BODY_MB=256
VOR_MAX_PENDING_IMAGES=250
VOR_THUMBNAIL_SIZE=640
VOR_DATA_DIR=./data
VOR_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
